// Blink-to-Stock database. Dedicated database only (MASTER_PROMPT VPS isolation): blink_to_stock.
// Run migrations through `npm run db:migrate`, which refuses unless DATABASE_URL targets BLINK_DATABASE_NAME.
// NEVER run `prisma migrate reset` against a shared or production database.
//
// Claim / Tap Rush / service-wallet tables follow owner-approved ASSUMPTIONS (docs/DECISIONS.md D-13) until
// the missing MASTER_PROMPT sections arrive.

generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CampaignType {
  GIFT
  TAP_RUSH
  EARLY_CLAIM
  REFERRAL
  SEEKER
  VERIFIED_QUEST
}

enum CampaignStatus {
  DRAFT
  AWAITING_FUNDING
  AWAITING_DELEGATION
  LIVE
  PAUSED
  ENDED
  CLOSED
}

enum SolanaCluster {
  localnet
  devnet
  mainnet_beta @map("mainnet-beta")
}

model Campaign {
  id                   String         @id @db.Uuid
  type                 CampaignType
  status               CampaignStatus @default(DRAFT)
  cluster              SolanaCluster
  /// Privy user id from a verified access token (MASTER_PROMPT §24).
  creatorPrivyUserId   String
  /// External Solana wallet verified by Privy SIWS and linked to creatorPrivyUserId (MASTER_PROMPT §25).
  creatorWallet        String
  mint                 String
  xstockSymbol         String
  /// CreateAccountWithSeed seed, 32 ASCII chars (MASTER_PROMPT §11).
  campaignSeed         String         @db.VarChar(32)
  /// Server-derived; re-derived and compared before every operation.
  campaignTokenAccount String
  /// Per-campaign delegate (MASTER_PROMPT §14). Null until provisioned.
  delegateAddress      String?
  delegateWalletRef    String?
  /// Raw base units (u64) as decimal — never float.
  allowanceRaw         Decimal        @db.Decimal(20, 0)
  /// D-13: fixed amount per recipient. Null = created before claiming existed (not claimable).
  rewardPerClaimRaw    Decimal?       @db.Decimal(20, 0)
  /// Reserved + paid. Only changed by conditional updates that keep it <= allowanceRaw.
  claimedRaw           Decimal        @default(0) @db.Decimal(20, 0)
  tapGoal              Int?
  tapSeconds           Int?
  /// D-21: Verified Quest requirements, frozen at creation (never edited once LIVE) + SHA-256 of their canonical JSON.
  requirementsJson     Json?
  requirementsHash     String?
  /// D-21: optional campaign window, enforced server-side.
  startsAt             DateTime?
  endsAt               DateTime?
  pauseReason          String?
  /// D-40: the club this drop is posted in (offchain).
  clubId               String?        @db.Uuid
  /// D-41: only members of clubId can take part.
  membersOnly          Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([cluster, campaignTokenAccount])
  @@unique([creatorWallet, campaignSeed])
  @@index([status])
  @@index([clubId])
}

/// MASTER_PROMPT §7 — every Blink-funded lamport, reserved before send and settled after confirmation.
model BudgetLedgerEntry {
  id             String        @id @default(uuid()) @db.Uuid
  cluster        SolanaCluster
  kind           String
  /// RESERVED | SPENT | RELEASED
  state          String
  lamports       BigInt
  campaignId     String?       @db.Uuid
  txSignature    String?       @unique
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([cluster, state])
}

enum ClaimStatus {
  RESERVED
  SENDING
  PAID
  FAILED
}

enum ClaimKind {
  CLAIM
  REFERRAL_BONUS
}

/// D-13/D-14: one reward of each kind per Privy user and per recipient wallet per campaign. A FAILED row is reused on retry.
model Claim {
  id                   String      @id @db.Uuid
  campaignId           String      @db.Uuid
  kind                 ClaimKind   @default(CLAIM)
  privyUserId          String
  /// Privy embedded wallet of privyUserId, resolved server-side.
  recipientWallet      String
  amountRaw            Decimal     @db.Decimal(20, 0)
  status               ClaimStatus @default(RESERVED)
  /// Fee-payer signature = transaction id; stored BEFORE sending so a retry never double-pays.
  txSignature          String?     @unique
  lastValidBlockHeight BigInt?
  failureReason        String?
  /// Tap Rush claims consume exactly one qualifying session.
  tapSessionId         String?     @unique @db.Uuid
  /// D-14: invite code a friend's CLAIM came through.
  referralCode         String?
  /// D-17: Seeker drops — the Seeker Genesis Token mint (device identity) that qualified this claim.
  sgtMint              String?
  /// D-14: a REFERRAL_BONUS names the friend's CLAIM that earned it; one bonus per friend claim.
  bonusForClaimId      String?     @unique @db.Uuid
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@unique([campaignId, privyUserId, kind])
  @@unique([campaignId, recipientWallet, kind])
  /// D-17: one claim per Seeker device per drop.
  @@unique([campaignId, sgtMint])
  @@index([privyUserId, createdAt])
  @@index([status])
}

model TapRushSession {
  id           String    @id @db.Uuid
  campaignId   String    @db.Uuid
  privyUserId  String
  goal         Int
  seconds      Int
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  taps         Int?
  qualified    Boolean   @default(false)
  /// D-14: why a finished round did not count (timing or tap-pattern check).
  rejectReason String?
  /// D-21: privacy-safe public label source (the player's Blink wallet) for the live leaderboard.
  publicWallet String?

  @@index([campaignId, privyUserId])
}

/// D-20: the user's latest xStocks eligibility decision (SECURITY.md §1). Minimum data: country codes, result,
/// reason, policy version, method, time. Never an IP address, precise location or identity document.
model XStockEligibility {
  privyUserId     String   @id
  declaredCountry String   @db.VarChar(2)
  notUsPerson     Boolean
  attestations    String[]
  /// Country of the request IP at decision time (ISO alpha-2), or null if unknown.
  ipCountry       String?  @db.VarChar(2)
  eligible        Boolean
  reason          String
  policyId        String
  policyVersion   String
  method          String
  decidedAt       DateTime @updatedAt
}

/// D-21: the latest server-side evaluation of a Verified Quest for one user. Public-safe summary only.
model QuestVerification {
  campaignId   String   @db.Uuid
  privyUserId  String
  qualified    Boolean
  /// QuestEvaluation (statuses + raw amounts as strings); no wallets or other identifiers.
  summary      Json
  /// Privacy-safe public label source for live events.
  publicWallet String?
  checkedAt    DateTime @updatedAt

  @@id([campaignId, privyUserId])
  @@index([campaignId, checkedAt])
}

/// D-14: a person's invite code for one REFERRAL campaign.
model Referral {
  code        String   @id
  campaignId  String   @db.Uuid
  privyUserId String
  createdAt   DateTime @default(now())

  @@unique([campaignId, privyUserId])
}

/// Blink-operated server wallets that are not per-campaign, e.g. the §16 fee payer. `role` includes the cluster.
model ServiceWallet {
  role      String   @id
  address   String
  walletRef String
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actor      String
  action     String
  campaignId String?  @db.Uuid
  /// Never store secrets, tokens or private keys here.
  details    Json
  createdAt  DateTime @default(now())

  @@index([campaignId, createdAt])
}

/// D-24: Expo push tokens, one row per device. A device that signs in to another account moves to that account.
model PushToken {
  token       String   @id
  privyUserId String
  platform    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([privyUserId])
}

/// D-37: optional public profile — unique username and a small profile picture served by an opaque public id.
model Profile {
  privyUserId   String    @id
  publicId      String    @unique
  username      String?   @unique
  avatar        Bytes?
  avatarType    String?
  avatarVersion Int       @default(0)
  /// D-45: OG marks (ORE, SEEKER, SKR) from the last mainnet check.
  og            String[]  @default([])
  ogCheckedAt   DateTime?
  /// D-52: verified .skr name — reverse-resolved from a SIWS-verified wallet AND forward-resolved back to it.
  skrName       String?
  skrWallet     String?
  skrCheckedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// D-38: sends from a Blink stock wallet (fees paid by Blink), for the user's history and receipts.
model Transfer {
  id          String   @id @db.Uuid
  privyUserId String
  cluster     String
  asset       String
  symbol      String
  decimals    Int
  amountRaw   Decimal  @db.Decimal(20, 0)
  toAddress   String
  signature   String   @unique
  status      String
  createdAt   DateTime @default(now())

  @@index([privyUserId, createdAt])
}

/// D-39: X task per person per campaign: their personal code and the verified post. One X account / post per campaign.
model XTask {
  campaignId   String    @db.Uuid
  privyUserId  String
  code         String
  postId       String?
  postUrl      String?
  authorHandle String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@id([campaignId, privyUserId])
  @@unique([campaignId, postId])
  @@unique([campaignId, authorHandle])
}

/// D-37: every username ever set stays with the account that first used it, so a released name can't be taken over.
model UsernameClaim {
  username    String   @id
  privyUserId String
  createdAt   DateTime @default(now())

  @@index([privyUserId])
}

/// D-40: clubs. Everything here is offchain Blink state; nothing is written to Solana.
model Club {
  id               String   @id @db.Uuid
  slug             String   @unique
  name             String
  description      String
  category         String
  tags             String[]
  visibility       String   @default("PUBLIC")
  /// Joining a PRIVATE club needs this code.
  inviteCode       String   @unique
  /// null = run by Blink (seeded clubs).
  ownerPrivyUserId String?
  /// D-41: join rules (QuestGroup[]); null/empty = anyone.
  rulesJson        Json?
  /// D-43: only the owner and admins can send messages.
  adminsOnly       Boolean  @default(false)
  pinnedMessageId  BigInt?
  createdAt        DateTime @default(now())

  @@index([ownerPrivyUserId, createdAt])
}

model ClubMember {
  clubId       String    @db.Uuid
  privyUserId  String
  /// OWNER | MOD | MEMBER
  role         String    @default("MEMBER")
  /// D-43: an admin muted this member until then.
  mutedUntil   DateTime?
  /// Truncated label source for members without a username; never shown in full.
  publicWallet String?
  joinedAt     DateTime  @default(now())

  @@id([clubId, privyUserId])
  @@index([privyUserId, joinedAt])
}

model ClubMessage {
  id                BigInt    @id @default(autoincrement())
  clubId            String    @db.Uuid
  authorPrivyUserId String
  authorWallet      String?
  body              String
  replyToId         BigInt?
  /// D-43: TEXT or VOICE; a voice note points at ClubVoice by its random public id.
  kind              String    @default("TEXT")
  voiceId           String?   @unique
  voiceMs           Int?
  /// D-44: a confirmed xStock gift between two members.
  giftId            String?   @unique @db.Uuid
  deletedAt         DateTime?
  deletedBy         String?
  createdAt         DateTime  @default(now())

  @@index([clubId, id])
}

model ClubMessageReaction {
  messageId   BigInt
  privyUserId String
  emoji       String
  createdAt   DateTime @default(now())

  @@id([messageId, privyUserId, emoji])
}

/// D-40: the random, server-issued code behind an event drop's QR (one per campaign; the creator can rotate it).
model EventCode {
  campaignId String   @id @db.Uuid
  token      String   @unique
  createdAt  DateTime @default(now())
}

model EventCheckin {
  campaignId  String   @db.Uuid
  privyUserId String
  createdAt   DateTime @default(now())

  @@id([campaignId, privyUserId])
  @@index([privyUserId, createdAt])
}

/// D-40: squads of up to CLUB_LIMITS.squadSize people in one drop; one squad per person per drop.
model Squad {
  id                 String   @id @db.Uuid
  campaignId         String   @db.Uuid
  name               String
  code               String   @unique
  captainPrivyUserId String
  maxSize            Int
  createdAt          DateTime @default(now())

  @@index([campaignId])
}

model SquadMember {
  squadId      String   @db.Uuid
  campaignId   String   @db.Uuid
  privyUserId  String
  publicWallet String?
  joinedAt     DateTime @default(now())

  @@id([squadId, privyUserId])
  @@unique([campaignId, privyUserId])
}

/// D-40: one report per person per message; enough distinct reports hide the message (CLUB_LIMITS.reportsToHide).
model ClubMessageReport {
  messageId   BigInt
  privyUserId String
  createdAt   DateTime @default(now())

  @@id([messageId, privyUserId])
}

/// D-43: removed members; they can't rejoin until an admin lets them back in.
model ClubBan {
  clubId        String   @db.Uuid
  privyUserId   String
  publicWallet  String?
  byPrivyUserId String
  createdAt     DateTime @default(now())

  @@id([clubId, privyUserId])
}

/// D-43: voice-note audio (AAC in MP4, ≤ 1 MB), served by its random id.
model ClubVoice {
  id        String   @id
  clubId    String   @db.Uuid
  bytes     Bytes
  mime      String
  createdAt DateTime @default(now())

  @@index([clubId])
}

/// D-44: an xStock gift between club members, sent from the sender's Blink wallet (Blink pays the fee).
model ClubGift {
  id                   String   @id @db.Uuid
  clubId               String   @db.Uuid
  senderPrivyUserId    String
  recipientPrivyUserId String
  senderWallet         String?
  mint                 String
  symbol               String
  decimals             Int
  amountRaw            Decimal  @db.Decimal(20, 0)
  cluster              String
  signature            String   @unique
  /// CONFIRMED or PENDING (still confirming when the request ended).
  status               String
  createdAt            DateTime @default(now())

  @@index([recipientPrivyUserId, createdAt])
  @@index([senderPrivyUserId, createdAt])
}

/// D-49: SKR tips. The sender's own wallet signs and pays; Blink only builds, relays and verifies.
/// Status: PREPARED → SUBMITTED → CONFIRMED | FAILED | EXPIRED. One confirmed transfer = one tip (signature unique).
model SkrTip {
  id                   String    @id @db.Uuid
  senderPrivyUserId    String
  recipientPrivyUserId String
  senderWallet         String
  recipientWallet      String
  clubId               String?   @db.Uuid
  amountRaw            Decimal   @db.Decimal(20, 0)
  cluster              String
  status               String
  signature            String?   @unique
  failure              String?
  createdAt            DateTime  @default(now())
  confirmedAt          DateTime?

  @@index([senderPrivyUserId, createdAt])
  @@index([recipientPrivyUserId, createdAt])
}

/// D-50: paid SKR boost of a funded drop. Confirmed transfer → fixed-duration featured entitlement, activated once.
/// startsAt/endsAt are set by the server at confirmation; a later boost extends from the current end.
model SkrBoost {
  id               String    @id @db.Uuid
  campaignId       String    @db.Uuid
  payerPrivyUserId String
  payerWallet      String
  destination      String
  amountRaw        Decimal   @db.Decimal(20, 0)
  hours            Int
  cluster          String
  status           String
  signature        String?   @unique
  failure          String?
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime  @default(now())
  confirmedAt      DateTime?

  @@index([campaignId, endsAt])
  @@index([payerPrivyUserId, createdAt])
}

/// D-51: an ORE deploy verified onchain (DeployEvent logged by the ORE program, manual strategy, this user's wallet).
/// The signature is unique: one deploy is one proof, whatever drop or mark it is used for.
model OreDeployProof {
  signature       String   @id
  privyUserId     String
  wallet          String
  roundId         Decimal  @db.Decimal(20, 0)
  squares         Int[]
  amountPerSquare Decimal  @db.Decimal(20, 0)
  totalLamports   Decimal  @db.Decimal(20, 0)
  slot            Decimal  @db.Decimal(20, 0)
  deployedAt      DateTime
  campaignId      String?  @db.Uuid
  createdAt       DateTime @default(now())

  @@index([privyUserId, createdAt])
}
