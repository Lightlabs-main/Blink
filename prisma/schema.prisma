// Blink-to-Stock database. Dedicated database only (MASTER_PROMPT VPS isolation): blink_to_stock.
// Run migrations through `npm run db:migrate`, which refuses unless DATABASE_URL targets BLINK_DATABASE_NAME.
// NEVER run `prisma migrate reset` against a shared or production database.
//
// Claim / Tap Rush / service-wallet tables follow owner-approved ASSUMPTIONS (docs/DECISIONS.md D-13) until
// the missing MASTER_PROMPT sections arrive.

generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CampaignType {
  GIFT
  TAP_RUSH
  EARLY_CLAIM
  REFERRAL
  SEEKER
  VERIFIED_QUEST
}

enum CampaignStatus {
  DRAFT
  AWAITING_FUNDING
  AWAITING_DELEGATION
  LIVE
  PAUSED
  ENDED
  CLOSED
}

enum SolanaCluster {
  localnet
  devnet
  mainnet_beta @map("mainnet-beta")
}

model Campaign {
  id                   String         @id @db.Uuid
  type                 CampaignType
  status               CampaignStatus @default(DRAFT)
  cluster              SolanaCluster
  /// Privy user id from a verified access token (MASTER_PROMPT §24).
  creatorPrivyUserId   String
  /// External Solana wallet verified by Privy SIWS and linked to creatorPrivyUserId (MASTER_PROMPT §25).
  creatorWallet        String
  mint                 String
  xstockSymbol         String
  /// CreateAccountWithSeed seed, 32 ASCII chars (MASTER_PROMPT §11).
  campaignSeed         String         @db.VarChar(32)
  /// Server-derived; re-derived and compared before every operation.
  campaignTokenAccount String
  /// Per-campaign delegate (MASTER_PROMPT §14). Null until provisioned.
  delegateAddress      String?
  delegateWalletRef    String?
  /// Raw base units (u64) as decimal — never float.
  allowanceRaw         Decimal        @db.Decimal(20, 0)
  /// D-13: fixed amount per recipient. Null = created before claiming existed (not claimable).
  rewardPerClaimRaw    Decimal?       @db.Decimal(20, 0)
  /// Reserved + paid. Only changed by conditional updates that keep it <= allowanceRaw.
  claimedRaw           Decimal        @default(0) @db.Decimal(20, 0)
  tapGoal              Int?
  tapSeconds           Int?
  /// D-21: Verified Quest requirements, frozen at creation (never edited once LIVE) + SHA-256 of their canonical JSON.
  requirementsJson     Json?
  requirementsHash     String?
  /// D-21: optional campaign window, enforced server-side.
  startsAt             DateTime?
  endsAt               DateTime?
  pauseReason          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([cluster, campaignTokenAccount])
  @@unique([creatorWallet, campaignSeed])
  @@index([status])
}

/// MASTER_PROMPT §7 — every Blink-funded lamport, reserved before send and settled after confirmation.
model BudgetLedgerEntry {
  id             String        @id @default(uuid()) @db.Uuid
  cluster        SolanaCluster
  kind           String
  /// RESERVED | SPENT | RELEASED
  state          String
  lamports       BigInt
  campaignId     String?       @db.Uuid
  txSignature    String?       @unique
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([cluster, state])
}

enum ClaimStatus {
  RESERVED
  SENDING
  PAID
  FAILED
}

enum ClaimKind {
  CLAIM
  REFERRAL_BONUS
}

/// D-13/D-14: one reward of each kind per Privy user and per recipient wallet per campaign. A FAILED row is reused on retry.
model Claim {
  id                   String      @id @db.Uuid
  campaignId           String      @db.Uuid
  kind                 ClaimKind   @default(CLAIM)
  privyUserId          String
  /// Privy embedded wallet of privyUserId, resolved server-side.
  recipientWallet      String
  amountRaw            Decimal     @db.Decimal(20, 0)
  status               ClaimStatus @default(RESERVED)
  /// Fee-payer signature = transaction id; stored BEFORE sending so a retry never double-pays.
  txSignature          String?     @unique
  lastValidBlockHeight BigInt?
  failureReason        String?
  /// Tap Rush claims consume exactly one qualifying session.
  tapSessionId         String?     @unique @db.Uuid
  /// D-14: invite code a friend's CLAIM came through.
  referralCode         String?
  /// D-17: Seeker drops — the Seeker Genesis Token mint (device identity) that qualified this claim.
  sgtMint              String?
  /// D-14: a REFERRAL_BONUS names the friend's CLAIM that earned it; one bonus per friend claim.
  bonusForClaimId      String?     @unique @db.Uuid
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@unique([campaignId, privyUserId, kind])
  @@unique([campaignId, recipientWallet, kind])
  /// D-17: one claim per Seeker device per drop.
  @@unique([campaignId, sgtMint])
  @@index([privyUserId, createdAt])
  @@index([status])
}

model TapRushSession {
  id           String    @id @db.Uuid
  campaignId   String    @db.Uuid
  privyUserId  String
  goal         Int
  seconds      Int
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  taps         Int?
  qualified    Boolean   @default(false)
  /// D-14: why a finished round did not count (timing or tap-pattern check).
  rejectReason String?
  /// D-21: privacy-safe public label source (the player's Blink wallet) for the live leaderboard.
  publicWallet String?

  @@index([campaignId, privyUserId])
}

/// D-20: the user's latest xStocks eligibility decision (SECURITY.md §1). Minimum data: country codes, result,
/// reason, policy version, method, time. Never an IP address, precise location or identity document.
model XStockEligibility {
  privyUserId     String   @id
  declaredCountry String   @db.VarChar(2)
  notUsPerson     Boolean
  attestations    String[]
  /// Country of the request IP at decision time (ISO alpha-2), or null if unknown.
  ipCountry       String?  @db.VarChar(2)
  eligible        Boolean
  reason          String
  policyId        String
  policyVersion   String
  method          String
  decidedAt       DateTime @updatedAt
}

/// D-21: the latest server-side evaluation of a Verified Quest for one user. Public-safe summary only.
model QuestVerification {
  campaignId   String   @db.Uuid
  privyUserId  String
  qualified    Boolean
  /// QuestEvaluation (statuses + raw amounts as strings); no wallets or other identifiers.
  summary      Json
  /// Privacy-safe public label source for live events.
  publicWallet String?
  checkedAt    DateTime @updatedAt

  @@id([campaignId, privyUserId])
  @@index([campaignId, checkedAt])
}

/// D-14: a person's invite code for one REFERRAL campaign.
model Referral {
  code        String   @id
  campaignId  String   @db.Uuid
  privyUserId String
  createdAt   DateTime @default(now())

  @@unique([campaignId, privyUserId])
}

/// Blink-operated server wallets that are not per-campaign, e.g. the §16 fee payer. `role` includes the cluster.
model ServiceWallet {
  role      String   @id
  address   String
  walletRef String
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actor      String
  action     String
  campaignId String?  @db.Uuid
  /// Never store secrets, tokens or private keys here.
  details    Json
  createdAt  DateTime @default(now())

  @@index([campaignId, createdAt])
}

/// D-24: Expo push tokens, one row per device. A device that signs in to another account moves to that account.
model PushToken {
  token       String   @id
  privyUserId String
  platform    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([privyUserId])
}

/// D-37: optional public profile — unique username and a small profile picture served by an opaque public id.
model Profile {
  privyUserId   String   @id
  publicId      String   @unique
  username      String?  @unique
  avatar        Bytes?
  avatarType    String?
  avatarVersion Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// D-38: sends from a Blink stock wallet (fees paid by Blink), for the user's history and receipts.
model Transfer {
  id          String   @id @db.Uuid
  privyUserId String
  cluster     String
  asset       String
  symbol      String
  decimals    Int
  amountRaw   Decimal  @db.Decimal(20, 0)
  toAddress   String
  signature   String   @unique
  status      String
  createdAt   DateTime @default(now())

  @@index([privyUserId, createdAt])
}

/// D-39: X task per person per campaign: their personal code and the verified post. One X account / post per campaign.
model XTask {
  campaignId   String    @db.Uuid
  privyUserId  String
  code         String
  postId       String?
  postUrl      String?
  authorHandle String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@id([campaignId, privyUserId])
  @@unique([campaignId, postId])
  @@unique([campaignId, authorHandle])
}
