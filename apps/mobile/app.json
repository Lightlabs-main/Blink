{
  "expo": {
    "scheme": "blinktostock",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "output": "static"
    },
    "name": "Blink-to-Stock",
    "slug": "blink",
    "owner": "marisdigitals11s-team",
    "android": {
      "package": "com.blinktostock.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "blinksol.site",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "blinksol.site",
              "pathPrefix": "/e/"
            },
            {
              "scheme": "https",
              "host": "blinksol.site",
              "pathPrefix": "/club/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#141210",
        "monochromeImage": "./assets/monochrome-icon.png"
      }
    },
    "extra": {
      "eas": {
        "projectId": "7dd3f562-b06d-4ec5-adb4-8f8a3f6bf90a"
      }
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "showMenuAtLaunch": false,
          "skipOnboarding": true
        }
      ],
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Blink uses the microphone only when you record a voice note in a club chat.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Blink-to-Stock uses the camera to scan campaign QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#141210",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#141210"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Blink uses a photo you choose as your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
