# Blink-to-Stock backend environment. Copy to .env (git-ignored). Blink-only values — never reuse another project's.
# Secrets live only here on the server. NEVER put PRIVY_APP_SECRET, HELIUS_API_KEY or any private key in the APK.

BLINK_ENV=local                       # local | test | mainnet
SOLANA_CLUSTER=devnet                 # localnet | devnet | mainnet-beta
SOLANA_RPC_URL=https://api.devnet.solana.com

# Mainnet guards (MASTER_PROMPT §7/§22). All three are required before any Blink-funded mainnet spend.
MAINNET_ENABLED=false
MAINNET_GO_APPROVED=false
MAINNET_BUDGET_LAMPORTS=20000000      # 0.02 SOL target; hard ceiling 100000000 is enforced in code

DEMO_MODE=false

# Check the host for port collisions first (VPS isolation).
API_HOST=127.0.0.1
API_PORT=4310

DATABASE_URL=postgresql://blink_app:CHANGE_ME@127.0.0.1:5432/blink_to_stock
BLINK_DATABASE_NAME=blink_to_stock

PRIVY_APP_ID=
PRIVY_APP_SECRET=

# PUBLIC_WEB_ORIGIN=https://<owner-provided-domain>
# HELIUS_API_KEY=
